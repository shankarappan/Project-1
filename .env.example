# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: service role for admin seed scripts and password signup
# (auto-confirms users so signup works without Supabase's 2 emails/hour mailer)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Which auth methods to show (comma-separated). Defaults to all.
# NEXT_PUBLIC_AUTH_PROVIDERS=magic,password,google,apple

# App URL (used for auth redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Provisioning only (npm run provision) — do not commit real values
# SUPABASE_ACCESS_TOKEN=
# VERCEL_TOKEN=
# SUPABASE_ORG_ID=
# VERCEL_TEAM_ID=
